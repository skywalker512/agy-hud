{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agy-hud-gemini-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "../../site/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  },
  "routes": [
    {
      "pattern": "agy-hud.512.pub",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GEMINI_PULSE_KV",
      "id": "11e314518f7f45acab30772eacad14e0"
    }
  ]
}
