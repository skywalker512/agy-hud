{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agy-hud-gemini-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "GEMINI_PULSE_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
