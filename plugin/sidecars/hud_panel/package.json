{
  "name": "hud_panel",
  "version": "1.2.0",
  "type": "module",
  "description": "AGY-HUD side-pane telemetry backend",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "../../../web/node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "test:all": "node --test test/*.test.ts ../../../tools/test/*.test.mjs",
    "build:ui": "npm --prefix ../../../web run build",
    "check": "npm run typecheck && npm run build:ui && npm run test:all"
  }
}
